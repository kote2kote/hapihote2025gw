---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import HeroBg from '../assets/img/Hero_bg.jpg';
import HeroBgsp from '../assets/img/Hero_bg_sp.jpg';
import HeroThumb from '../assets/img/Hero_influencer.png';
import Sec01Thumb from '../assets/img/Sec01_thmub.jpg';
import Sec01Bg from '../assets/img/Sec01_bg.jpg';
import Sec02Thumb from '../assets/img/Sec02_thmub.jpg';
import Sec02Bg from '../assets/img/Sec02_bg.jpg';
import Sec03Thumb from '../assets/img/Sec03_thmub.jpg';
import Sec03Bg from '../assets/img/Sec03_bg.jpg';
import ImgFDammy from '../assets/img/Feature01_shop01.jpg';
