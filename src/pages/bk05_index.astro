---
import Layout from "../layouts/Layout.astro";
import { Picture } from "astro:assets";
import HeroBg from "../assets/img/Hero_bg.jpg";
import HeroBgsp from "../assets/img/Hero_bg_sp.jpg";
import HeroThumb from "../assets/img/Hero_influencer.png";
import Heropic01 from "../assets/img/Hero_pic01.png";
import Heropic02 from "../assets/img/Hero_pic02.png";
import Heropic03 from "../assets/img/Hero_pic03.png";
import Heropic04 from "../assets/img/Hero_pic04.png";
import Heropic05 from "../assets/img/Hero_pic05.png";
import Heropic06 from "../assets/img/Hero_pic06.png";
import Sec01Pic01 from "../assets/img/Sec01_pic01.jpg";
import Sec01Pic02 from "../assets/img/Sec01_pic02.jpg";
import Sec01Bg from "../assets/img/Sec01_bg.jpg";
import Sec02Pic01 from "../assets/img/Sec02_pic01.jpg";
import Sec02Pic02 from "../assets/img/Sec02_pic02.jpg";
import Sec02Bg from "../assets/img/Sec02_bg.jpg";
import Sec03Pic01 from "../assets/img/Sec03_pic01.jpg";
import Sec03Pic02 from "../assets/img/Sec03_pic02.jpg";
import Sec03Bg from "../assets/img/Sec03_bg.jpg";
import LinkBg from "../assets/img/Link_bg.jpg";
import LinkBgSp from "../assets/img/Link_bg@sp.jpg";
---

<Layout>
  <main class="h2025gw bg-white">
    <!-----------------------------------------------------------
		#Hero
		------------------------------------------------------------>
    <section id="Hero">
      <div
        class="inner relative pt-[calc(100/375*16*1vw)] md:pt-[44px] pb-[46px] md:pb-[30px] overflow-hidden"
      >
        <img
          class="el_ribbon1 gsap_ribbon opacity-0 hidden md:inline-block w-[calc(100/375*171*1vw)] md:w-[482px] c1100:w-[calc(100/1680*737*1vw)] absolute top-[-10%] left-[-2%]"
          src="/assets/2025gw/img/Hero_ribbon-tl.svg"
          alt=""
        />
        <img
          class="el_ribbon2 gsap_ribbon opacity-0 hidden md:inline-block w-[calc(100/375*139*1vw)] md:w-[278px] c1100:w-[calc(100/1680*426*1vw)] absolute top-[-8%] right-[-6%]"
          src="/assets/2025gw/img/Hero_ribbon-tr.svg"
          alt=""
        />
        <img
          class="el_ribbon3 gsap_ribbon opacity-0 md:hidden inline-block w-[calc(100/375*171*1vw)] md:w-[482px] c1100:w-[calc(100/1680*737*1vw)] absolute top-[-1%] left-[-2%]"
          src="/assets/2025gw/img/Hero_ribbon-tl@sp.svg"
          alt=""
        />
        <img
          class="el_ribbon4 gsap_ribbon hidden opacity-0 md:inline-block md:w-[278px] c1100:w-[calc(100/1680*426*1vw)] absolute top-[-1%] right-[-6%]"
          src="/assets/2025gw/img/Hero_ribbon-tr@sp.svg"
          alt=""
        />
        <img
          class="el_ribbon5 gsap_ribbon hidden opacity-0 md:inline-block md:w-[372px] c1100:w-[calc(100/1680*569*1vw)] absolute bottom-[-1%] left-[-5%]"
          src="/assets/2025gw/img/Hero_ribbon-bl.svg"
          alt=""
        />
        <img
          class="el_ribbon6 gsap_ribbon hidden opacity-0 md:inline-block md:w-[482px] c1100:w-[calc(100/1680*737*1vw)] absolute bottom-[1%] right-[-5%]"
          src="/assets/2025gw/img/Hero_ribbon-br.svg"
          alt=""
        />
        <div class="outer_canvas relative">
          <div
            class="outer_pic w-full md:w-[1200px] c1100:w-[110vw] flex gap-[calc(100/1680*40*1vw)] md:translate-x-[-5%]"
          >
          <Picture
          formats={["avif", "webp"]}
          class="el_img1 gsap_img opacity-0 hidden md:inline-block w-full object-cover aspect-auto"
          src={Heropic01}
          alt=""
        />
        <Picture
          formats={["avif", "webp"]}
          class="el_img2 gsap_img opacity-0 inline-block w-full object-cover aspect-auto"
          src={Heropic02}
          alt=""
        />
        <Picture
          formats={["avif", "webp"]}
          class="el_img3 gsap_img opacity-0 inline-block w-full object-cover aspect-auto"
          src={Heropic03}
          alt=""
        />
        <Picture
          formats={["avif", "webp"]}
          class="el_img4 gsap_img opacity-0 inline-block w-full object-cover aspect-auto"
          src={Heropic04}
          alt=""
        />
        <Picture
          formats={["avif", "webp"]}
          class="el_img5 gsap_img opacity-0 inline-block w-full object-cover aspect-auto"
          src={Heropic05}
          alt=""
        />
        <Picture
          formats={["avif", "webp"]}
          class="el_img6 gsap_img opacity-0 hidden md:inline-block w-full object-cover aspect-auto"
          src={Heropic06}
          alt=""
        />
          </div>
          <div
            class="outer_text-block opacity-0 absolute top-0 left-0 w-full h-full flex justify-center pt-[calc(100/375*21*1vw)] md:pt-[100px]"
          >
            <div class="inner flex flex-col items-center">
              <img
                class="el_img-gw inline-block w-[calc(100/375*326*1vw)] md:w-[344px] c1100:w-[calc(100/1680*522*1vw)] object-cover aspect-auto mb-[calc(100/1680*10*1vw)]"
                src="/assets/2025gw/img/Hero_text-lead.svg"
                alt=""
              />
              <div class="outer_hapihote relative z-10">
                <img
                  class="el_img-hapihote inline-block w-[calc(100/375*290*1vw)] md:w-[528px] c1100:w-[calc(100/1680*813*1vw)] object-cover aspect-auto"
                  src="/assets/2025gw/img/Hero_text-hapihote.svg"
                  alt="HAPIHOTE!"
                />
                <img
                  class="el_img-text-pink absolute top-1/2 -translate-y-1/2 left-1/2 -translate-x-1/2 inline-block w-[calc(100/375*711*1vw)] md:w-[468px] c1100:w-[calc(100/1680*711*1vw)] object-cover aspect-auto"
                  src="/assets/2025gw/img/Hero_text-pink.svg"
                  alt=""
                />
              </div>
              <div class="outer_fukidashi relative">
                <img
                  class="el_img-fukidashi inline-block w-[calc(100/375*268*1vw)] md:w-[514px] c1100:w-[calc(100/1680*778*1vw)] translate-y-[-15%] object-cover aspect-auto"
                  src="/assets/2025gw/img/Hero_fukidashi.svg"
                  alt=""
                />
                <div
                  class="inner-outer absolute top-0 left-0 w-full h-full text-center pt-[calc(100/375*16*1vw)] md:pt-[10px] c1100:pt-[calc(100/1680*20*1vw)]"
                >
                  <img
                    class="el_img-blue gsap_ribbon opacity-0 absolute top-[calc(100/375*30*1vw)] md:top-[calc(100/1680*70*1vw)] left-1/2 -translate-x-1/2 inline-block w-[calc(100/375*254px*1vw)] md:w-[486px] c1100:w-[calc(100/1680*737*1vw)] object-cover aspect-auto"
                    src="/assets/2025gw/img/Hero_ribbon-blue.svg"
                    alt=""
                  />
                  <img
                    class="el_img-yellow-l opacity-0 hidden md:inline-block absolute top-[140px] c1100:top-[calc(100/1680*240*1vw)] left-[-4%] w-[60px] c1100:w-[calc(100/1680*100*1vw)] object-cover aspect-auto"
                    src="/assets/2025gw/img/Hero_ribbon-yellow.svg"
                    alt=""
                  />
                  <img
                    class="el_img-yellow-r opacity-0 hidden md:inline-block absolute rotate-90 top-[-160px] c1100:top-[calc(-100/1680*220*1vw)] right-[-25%] w-[60px] c1100:w-[calc(100/1680*100*1vw)] object-cover aspect-auto"
                    src="/assets/2025gw/img/Hero_ribbon-yellow.svg"
                    alt=""
                  />
                  <h2
                    class="el_h text-[calc(100/375*16*1vw)] md:text-[34px] c1100:text-[calc(100/1680*50*1vw)] font-bold leading-[1.3] relative"
                  >
                    GWこそ時間を有効活用!<br />
                    ハピホテ使いこなし術をご紹介!
                  </h2>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div
          class="outer_text opacity-0 px-[20px] md:px-0 relative md:text-center text-[calc(100/375*16*1vw)] md:text-[18px] font-bold leading-[2] md:leading-[2.3] pt-[20px]"
        >
          <span class="bg-white md:p-2">GWはハピホテで決まり！！</span><br />
          <span class="bg-white md:p-2"
            >せっかくの連休は近場も遠出も、いつもよりアップデートした思い出を作りたい！</span
          ><br />
          <span class="bg-white md:p-2"
            >混雑するGWも、ハピホテをフル活用でストレスフリーに過ごしちゃおう♪</span
          ><br />
          <span class="bg-white md:p-2"
            >ハピホテファミリーのうたとるかが、とっておきの裏技をご紹介！</span
          ><br />
          <span class="bg-white md:p-2"
            >これであなたもGWを満喫できること間違いなし！</span
          >
        </div>
      </div>
    </section>

    <!-----------------------------------------------------------
		#Sec1
		------------------------------------------------------------>
    <section id="Sec1">
      <div class="inner relative pt-[calc(100/375*90*1vw)] md:pt-0">
        <div
          class="el_bg-photo absolute top-0 left-0 w-full h-full md:pt-[100px]"
        >
          <Picture
            formats={["avif", "webp"]}
            class="el_img inline-block w-full h-full object-cover aspect-auto"
            src={Sec01Bg}
            alt="海の背景画像"
          />
        </div>
        <!-- .sec_top --------------------------------------------------->
        <section class="sec_top px-[30px]">
          <div class="inner relative">
            <div
              class="outer_height hidden md:block md:h-[500px] c1100:h-[calc(100/1680*750*1vw)]"
            >
            </div>
            <div
              class="inner-outer md:absolute md:top-[130px] c1100:top-[12vw] md:left-[12%] w-full md:w-[88%] c1100:w-[84vw] md:h-[360px] c1100:h-[calc(100/1680*550*1vw)] bg-[#F9FD3A] rounded-[20px]"
            >
              <div class="inner maxmd:w-[90%] maxmd:mx-auto relative h-full">
                <h3
                  class="outer_h maxmd:space-y-[calc(100/375*6*1vw)] pt-[calc(100/375*54*1vw)] md:pt-0 md:absolute top-[19%] left-[40%] text-[calc(100/375*18*1vw)] md:text-[16px] c1100:text-[calc(100/1680*25*1vw)] font-bold"
                >
                  <div class="outer_h-01 relative">
                    <img
                      class="el_img absolute top-[calc(100/375*16*1vw)] md:top-[calc(100/1680*26*1vw)] left-0 w-[calc(100/375*247*1vw)] md:w-[calc(100/1680*350*1vw)] inline-block"
                      src="/assets/2025gw/img/Sec01_line01.svg"
                      alt=""
                    />
                    <span class="el_span relative"
                      >旅の主役は観光だけじゃない！</span
                    >
                  </div>
                  <div class="outer_h-02 relative">
                    <img
                      class="el_img absolute top-[calc(100/375*16*1vw)] md:top-[calc(100/1680*26*1vw)] left-0 w-[calc(100/375*186*1vw)] md:w-[calc(100/1680*263*1vw)] inline-block"
                      src="/assets/2025gw/img/Sec01_line02.svg"
                      alt=""
                    />
                    <span class="el_span relative">とびきり素敵な空間で、</span>
                  </div>
                  <div class="outer_h-03 relative">
                    <img
                      class="el_img absolute top-[calc(100/375*16*1vw)] md:top-[calc(100/1680*26*1vw)] left-0 w-[calc(100/375*186*1vw)] md:w-[calc(100/1680*263*1vw)] inline-block"
                      src="/assets/2025gw/img/Sec01_line03.svg"
                      alt=""
                    />
                    <span class="el_span relative">2人だけの贅沢な時間を</span>
                  </div>
                </h3>
                <div
                  class="outer_p maxmd:space-y-[calc(100/375*16*1vw)] maxmd:pt-[calc(100/375*16*1vw)] maxmd:pb-[calc(100/375*26*1vw)] md:absolute top-[50%] left-[20%] font-medium"
                >
                  <p
                    class="el_p1 leading-[1.8] md:leading-[2] text-[calc(100/375*15*1vw)] md:text-[10px] c1100:text-[calc(100/1680*15*1vw)] pb-[calc(100/1680*40*1vw)]"
                  >
                    GWといえば、旅行にぴったりな大型連休。<br />
                    でも・・・どこもかしこも人で溢れかえりホテルも普段の倍以上のお値段・・・
                  </p>
                  <p
                    class="el_p2 leading-[1.8] md:leading-[2] text-[calc(100/375*15*1vw)] md:text-[10px] c1100:text-[calc(100/1680*15*1vw)] pb-[calc(100/1680*40*1vw)]"
                  >
                    スペシャルシーズンこそ、実はラブホテルがおすすめ♡<br />
                    比較的リーズナブルで、日常を忘れさせてくれるエンタメ要素満載のお部屋たちにワクワクが止まらない！<br
                    />
                    いつもと違った雰囲気を味わおう♪
                  </p>
                  <p
                    class="el_p3 text-[calc(100/375*15*1vw)] md:text-[10px] c1100:text-[calc(100/1680*15*1vw)]"
                  >
                    ハピホテではたくさんの宿泊予約プランが掲載されているから、気になるホテルを探してみてね！
                  </p>
                </div>
                <img
                  class="el_num inline-block absolute top-[1%] md:top-0 -translate-y-1/2 right-[3%] md:right-[15%] w-[calc(100/375*109_*1vw)] md:w-[calc(100/1680*162*1vw)] object-cover aspect-auto"
                  src="/assets/2025gw/img/Sec01_num.svg"
                  alt=""
                />
                <div
                  class="outer_text hidden md:block absolute top-0 -translate-y-[10%] right-[10%] text-[calc(100/1680*12*1vw)] v_font-jost font-bold [writing-mode:vertical-rl]"
                >
                  ENJOY A LUXURIOUS TIME FOR TWO AT<br />
                  IN THE MOST WONDERFUL SPACE.
                </div>
              </div>
            </div>
            <Picture
              formats={["avif", "webp"]}
              class="el_img1 absolute top-[-3%] md:top-0 left-[5%] md:left-0 translate-y-[-60%] md:translate-y-0 inline-block w-[calc(100/375*134*1vw)] md:w-[458px] c1100:w-[calc(100/1680*700*1vw)] object-cover aspect-auto rounded-lg md:rounded-[20px]"
              src={Sec01Pic01}
              alt="海辺のカップルの写真"
            />
            <Picture
              formats={["avif", "webp"]}
              class="el_img2 absolute top-[-5%] md:top-[220px] c1100:top-[20vw] left-[36%] md:left-[5vw] inline-block w-[calc(100/375*50*1vw)] md:w-[170px] c1100:w-[calc(100/1680*260*1vw)] object-cover aspect-auto rounded-lg md:rounded-[20px]"
              src={Sec01Pic02}
              alt="夕焼けの海辺で乾杯の写真"
            />
          </div>
        </section>
        <!-- .sec_bottom --------------------------------------------------->
        <section class="sec_bottom relative">
          <div
            class="inner flex justify-center py-[calc(100/375*30*1vw)] px-[calc(100/375*20*1vw)] md:py-[56px]"
          >
            <blockquote
              class="instagram-media"
              data-instgrm-permalink="https://www.instagram.com/reel/C60pAufL9dA/?utm_source=ig_embed&utm_campaign=loading"
              data-instgrm-version="14"
              style=" background:#FFF; border:0; border-radius:3px; box-shadow:0 0 1px 0 rgba(0,0,0,0.5),0 1px 10px 0 rgba(0,0,0,0.15); margin: 1px; max-width:540px; min-width:326px; padding:0; width:99.375%; width:-webkit-calc(100% - 2px); width:calc(100% - 2px);"
            >
              <div style="padding:16px;">
                <a
                  href="https://www.instagram.com/reel/C60pAufL9dA/?utm_source=ig_embed&utm_campaign=loading"
                  style=" background:#FFFFFF; line-height:0; padding:0 0; text-align:center; text-decoration:none; width:100%;"
                  target="_blank"
                >
                  <div
                    style=" display: flex; flex-direction: row; align-items: center;"
                  >
                    <div
                      style="background-color: #F4F4F4; border-radius: 50%; flex-grow: 0; height: 40px; margin-right: 14px; width: 40px;"
                    >
                    </div>
                    <div
                      style="display: flex; flex-direction: column; flex-grow: 1; justify-content: center;"
                    >
                      <div
                        style=" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; margin-bottom: 6px; width: 100px;"
                      >
                      </div>
                      <div
                        style=" background-color: #F4F4F4; border-radius: 4px; flex-grow: 0; height: 14px; width: 60px;"
                      >
                      </div>
                    </div>
                  </div><div style="padding: 19% 0;"></div>
                  <div
                    style="display:block; height:50px; margin:0 auto 12px; width:50px;"
                  >
                    <svg
                      width="50px"
                      height="50px"
                      viewBox="0 0 60 60"
                      version="1.1"
                      xmlns="https://www.w3.org/2000/svg"
                      xmlns:xlink="https://www.w3.org/1999/xlink"
                      ><g
                        stroke="none"
                        stroke-width="1"
                        fill="none"
                        fill-rule="evenodd"
                        ><g
                          transform="translate(-511.000000, -20.000000)"
                          fill="#000000"
                          ><g
                            ><path
                              d="M556.869,30.41 C554.814,30.41 553.148,32.076 553.148,34.131 C553.148,36.186 554.814,37.852 556.869,37.852 C558.924,37.852 560.59,36.186 560.59,34.131 C560.59,32.076 558.924,30.41 556.869,30.41 M541,60.657 C535.114,60.657 530.342,55.887 530.342,50 C530.342,44.114 535.114,39.342 541,39.342 C546.887,39.342 551.658,44.114 551.658,50 C551.658,55.887 546.887,60.657 541,60.657 M541,33.886 C532.1,33.886 524.886,41.1 524.886,50 C524.886,58.899 532.1,66.113 541,66.113 C549.9,66.113 557.115,58.899 557.115,50 C557.115,41.1 549.9,33.886 541,33.886 M565.378,62.101 C565.244,65.022 564.756,66.606 564.346,67.663 C563.803,69.06 563.154,70.057 562.106,71.106 C561.058,72.155 560.06,72.803 558.662,73.347 C557.607,73.757 556.021,74.244 553.102,74.378 C549.944,74.521 548.997,74.552 541,74.552 C533.003,74.552 532.056,74.521 528.898,74.378 C525.979,74.244 524.393,73.757 523.338,73.347 C521.94,72.803 520.942,72.155 519.894,71.106 C518.846,70.057 518.197,69.06 517.654,67.663 C517.244,66.606 516.755,65.022 516.623,62.101 C516.479,58.943 516.448,57.996 516.448,50 C516.448,42.003 516.479,41.056 516.623,37.899 C516.755,34.978 517.244,33.391 517.654,32.338 C518.197,30.938 518.846,29.942 519.894,28.894 C520.942,27.846 521.94,27.196 523.338,26.654 C524.393,26.244 525.979,25.756 528.898,25.623 C532.057,25.479 533.004,25.448 541,25.448 C548.997,25.448 549.943,25.479 553.102,25.623 C556.021,25.756 557.607,26.244 558.662,26.654 C560.06,27.196 561.058,27.846 562.106,28.894 C563.154,29.942 563.803,30.938 564.346,32.338 C564.756,33.391 565.244,34.978 565.378,37.899 C565.522,41.056 565.552,42.003 565.552,50 C565.552,57.996 565.522,58.943 565.378,62.101 M570.82,37.631 C570.674,34.438 570.167,32.258 569.425,30.349 C568.659,28.377 567.633,26.702 565.965,25.035 C564.297,23.368 562.623,22.342 560.652,21.575 C558.743,20.834 556.562,20.326 553.369,20.18 C550.169,20.033 549.148,20 541,20 C532.853,20 531.831,20.033 528.631,20.18 C525.438,20.326 523.257,20.834 521.349,21.575 C519.376,