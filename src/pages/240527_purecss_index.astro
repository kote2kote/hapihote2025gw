---
import Layout from '../layouts/Layout.astro';
import { Picture } from 'astro:assets';
import HeroBg from '../assets/img/Hero_bg.jpg';
import HeroBgsp from '../assets/img/Hero_bg_sp.jpg';
import HeroThumb from '../assets/img/Hero_influencer.png';
import Sec01Thumb from '../assets/img/Sec01_thmub.jpg';
import Sec01Bg from '../assets/img/Sec01_bg.jpg';
import Sec02Thumb from '../assets/img/Sec02_thmub.jpg';
import Sec02Bg from '../assets/img/Sec02_bg.jpg';
import Sec03Thumb from '../assets/img/Sec03_thmub.jpg';
import Sec03Bg from '../assets/img/Sec03_bg.jpg';
---

<Layout>
	<main>
		<!-----------------------------------------------------------
		#Hero
		------------------------------------------------------------>
		<section id="Hero" class="">
			<div class="el_bg-photo gsap--mp5511ms">
				<Picture formats={['avif', 'webp']} class="el_bg--pc" src={HeroBg} alt="" />
				<Picture formats={['avif', 'webp']} class="el_bg--sp" src={HeroBgsp} alt="" />
			</div>
			<div class="el_bg--black"></div>
			<div class="inner">
				<div class="outer_col1--gd5624ix">
					<h1 class="el_h gsap--cq5633pn">ハピホテを賢く使って<br />
						夏休みを<br class="md:hidden" />全力で楽しもう！</h1>
					<p class="el_p gsap--vw0101si">街ブラ・レジャー・旅行先……<br class="c_pc-hidden" /><span class="el_span ">困りたくないカップルへ</span><span>夏のハピホテ活用法！</span></p>
					<p class="el_p-en gsap--nb0116pv">Happiest Hote Utilization in Summer!</p>
				</div>
				<div class="outer_col2--cr0239ao">
					<div class="col1--lw0252hd">
						<div class="inner">
							<div class="col1--yg0306zq">
								<h3 class="el_h gsap--cu0315gd">INTRODUCTION BY UTATORUKA</h3>
								<p class="el_p gsap--xh0330pv">
									✨非日常感を味わえるラブホテルを紹介✨<br />
									instagramラブホ系１位のフォロワー数<br />
									♡ カップルや女子会におすすめな<br class="c_pc-hidden" />ラブホテル巡り𖠋𖠋 ❤︎</p>
							</div>
							<div class="col2--tq0338fv">
								<svg class="gsap--ds1058cx" xmlns="http://www.w3.org/2000/svg" width="29.919" height="28.82" viewBox="0 0 29.919 28.82">
									<path id="rect_1" data-name="rect_1" d="M11.5,0,23,20H0Z" transform="translate(0 11.5) rotate(-30)" fill="#fff"/>
								</svg>
							</div>
						</div>
					</div>
					<div class="col2--ba0410ky">
						<Picture formats={['avif', 'webp']} class="gsap--qm1112ha" src={HeroThumb} alt="INFLUENCER うたとるか" />
					</div>
				</div>
			</div>
		</section>

		<!-----------------------------------------------------------
		#Introduce
		------------------------------------------------------------>
		<section id="Introduce" class="">
			<div class="inner">
				<div class="outer_col1--id0421cu">
					<p class="el_p gsap--bw0430zq">
						今年もやってきました！！待ちに待った夏休み！！！<br />
						せっかくのお休み、友人・恋人など大切な方と特別な思い出を作りたいですよね。<br />
						混む時期だけどホテルだって妥協したくない！そんな時はハピホテをフル活用！！<br />
						シチュエーションに合わせてハピホテファミリーのうたとるかに紹介してもらいます。</p>
				</div>
			</div>
		</section>

		<!-----------------------------------------------------------
		#Sec1
		------------------------------------------------------------>
		<section id="Sec1">
			<div class="inner">
				<div class="el_bg-photo">
					<Picture formats={['avif', 'webp']} class="" src={Sec01Bg} alt="" />
				</div>
			<!-- .section --------------------------------------------------->
			<section class="section--bv0439hm">
				<div class="inner">
					<div class="el_bg"></div>
					<div class="outer_col2--rw0508fa">
						<div class="col1--gg0514au">
							<Picture formats={['avif', 'webp']} class="el_pic gsap--az1043kh" src={Sec01Thumb} alt="浅草寺雷門の写真" />
						</div>
						<div class="col2--hw0521qv gsap--gy0531qd">
							<div class="outer-top">
								<h3 class="el_h">Situation</h3>
								<h4 class="el_h2">01</h4>
								<p class="el_p">
									観光名所で街ブラ中<span class="hidden md:inline-block">、</span>ひとやすみしたくなったら<br />
									ハピホテKeepで<br />
									近くのホテルを押さえよう！
								</p>
							</div>
							<div class="outer-bottom">
								<p class="el_p">
									夏休みはデートがたくさんできるチャンス！でも、ちょっとふたりになりたいときとかに限ってなかなかホテルが空いてない…普段来ない所だから、どこにホテルがあるのかわからない！そんな悩みもKeepで全部解決！
								</p>
							</div>
						</div>
					</div>
				</div>
