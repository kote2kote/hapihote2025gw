					<div class="outer_col2 max-w-[1390px] flex flex-col md:flex-row gap-[calc(100/375*20*1vw)] md:gap-[68px] relative">
						<div class="col1 w-full min1390:shrink-0 md:w-3/4 maxmd:pr-[calc(100/375*20*1vw)]">
