	<main>
		<!-----------------------------------------------------------
		#Hero
		------------------------------------------------------------>
		<section id="Hero" class="relative px-[calc(100/375*20*1vw)] pt-[calc(100/375*32*1vw)] pb-[calc(100/375*15*1vw)] md:px-[2rem] md:pt-[50px] md:pb-[42px]">
			<div class="el_bg-photo absolute top-0 left-0 w-full h-full">
				<Picture formats={['avif', 'webp']} class="hidden md:inline-block w-full h-full object-cover aspect-auto" src={HeroBg} alt="" />
				<Picture formats={['avif', 'webp']} class="md:hidden inline-block w-full h-full object-cover aspect-auto" src={HeroBgsp} alt="" />
			</div>
			<div class="el_bg-black absolute top-0 left-0 bg-black w-full h-full opacity-40"></div>
			<div class="inner max-w-[1100px] mx-auto relative">
				<div class="outer_col1">
					<h1 class="el_h v_font-sans-serif text-center text-white text-[calc(100/375*30*1vw)] md:text-[59px] font-bold leading-[1.2] pb-[calc(100/375*10*1vw)] md:pb-[10px]">ハピホテを賢く使って<br />
						夏休みを<br class="md:hidden" />全力で楽しもう！</h1>
					<p class="el_p v_font-sans-serif text-center text-white text-[calc(100/375*15*1vw)] md:text-[21px] font-bold pb-[calc(100/375*20*1vw)] md:pb-[20px]">街ブラ・レジャー・旅行先……<br class="md:hidden" /><span class="inline-block md:mr-[1em]">困りたくないカップルへ</span><span>夏のハピホテ活用法！</span></p>
					<p class="el_p-en v_font-damion text-center text-white text-[calc(100/375*16*1vw)] md:text-[32px] pb-[25px] flex items-center before:content-[''] before:mr-[calc(100/375*8*1vw)] before:h-[2px] md:before:h-[4px] before:bg-white before:grow after:content-[''] after:ml-[calc(100/375*8*1vw)] md:after:ml-[20px] after:h-[2px] md:after:h-[4px] after:bg-white after:grow">Happiest Hote Utilization in Summer!</p>
					</div>
				<div class="outer_col2 max-w-[780px] mx-auto grid grid-cols-1 md:grid-cols-[1fr_160px]">
					<div class="col1 maxmd:order-2">
						<div class="inner-outer_col2 flex maxmd:flex-col">
							<div class="col1 maxmd:order-2 relative flex flex-col maxmd:gap-[calc(100/375*10*1vw)] w-full">
								<h3 class="maxmd:order-2 v_font-josefin text-white text-center text-[calc(100/375*12*1vw)] md:text-[12px] font-bold tracking-[0.4em] md:pb-[10px]">INTRODUCTION BY UTATORUKA</h3>
								<p class="maxmd:order-1 v_font-sans-serif text-center text-[calc(100/375*13*1vw)] md:text-[15px] bg-white p-[calc(100/375*10*1vw)] md:py-[30px] rounded-[30px]">
									✨非日常感を味わえるラブホテルを紹介✨<br />
									instagramラブホ系１位のフォロワー数<br />
									♡ カップルや女子会におすすめな<br class="md:hidden" />ラブホテル巡り𖠋𖠋 ❤︎</p>
							</div>
							<div class="col2 maxmd:order-1 maxmd:flex maxmd:justify-center">
								<svg class="rotate-[30deg] translate-y-[10px] md:rotate-0 md:translate-x-[-15px] md:translate-y-[60px]" xmlns="http://www.w3.org/2000/svg" width="29.919" height="28.82" viewBox="0 0 29.919 28.82">
									<path id="rect_1" data-name="rect_1" d="M11.5,0,23,20H0Z" transform="translate(0 11.5) rotate(-30)" fill="#fff"/>
								</svg>
							</div>
						</div>
					</div>
					<div class="col2 text-center maxmd:order-1">
						<!-- <img class="inline-block w-[calc(100/375*128*1vw)] md:w-full object-cover aspect-auto" src="./assets/2024summer/img/Hero_influencer.png" alt="INFLUENCER うたとるか" /> -->
						<Picture formats={['avif', 'webp']} class="inline-block w-[calc(100/375*128*1vw)] md:w-full object-cover aspect-auto" src={HeroThumb} alt="INFLUENCER うたとるか" />
					</div>
				</div>
			</div>
		</section>

		<!-----------------------------------------------------------
		#Introduce
		------------------------------------------------------------>
		<section id="Introduce" class="px-[calc(100/375*20*1vw)] py-[calc(100/375*45*1vw)] md:px-[2rem] md:py-[80px]">
			<div class="inner max-w-[1100px] mx-auto">
				<div class="outer_col1">
					<p class="leading-[2] v_font-sans-serif font-bold md:text-center text-[calc(100/375*16*1vw)] md:text-[18px]">夏休みがもうすぐですね。友達・恋人・夫婦で、普段行かない特別な場所へ行くのはいいけれど、<br />
						いざという時ホテルがない！なんて悲しいことは絶対避けたいですよね？<br />
						そんなあなたに、シチュエーションごとにハピホテ活用術を<br />
						ハピホテファミリーのうたとるかに紹介してもらいます。</p>
				</div>
			</div>
		</section>

		<!-----------------------------------------------------------
		#Sec1
		------------------------------------------------------------>
		<section id="Sec1">
			<div class="inner relative">
				<div class="el_bg-photo absolute top-0 left-0 w-full h-full">
					<Picture formats={['avif', 'webp']} class="inline-block w-full h-full object-cover aspect-auto" src={Sec01Bg} alt="" />
